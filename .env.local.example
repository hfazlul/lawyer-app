DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/lawyer_db?schema=public"
AUTH_SECRET="generate-a-random-secret-at-least-32-chars"
# Must match the exact URL users open in the browser (scheme + host, including www).
# VPS example (HTTP): AUTH_URL="http://advmusa.com"
# After enabling HTTPS in nginx/certbot: AUTH_URL="https://advmusa.com"
AUTH_URL="http://localhost:3000"
CRON_SECRET="optional-secret-for-archive-purge-cron"
NODE_ENV="development"

# Production (VPS): set NODE_ENV=production and AUTH_URL to your live https URL before npm run build.
# See DEPLOY-HOSTINGER.md for full Hostinger VPS setup.

# Admin panel URL prefix (no leading slash). Default: musaAdv (advmusa.com).
# For advsaiful.com set: NEXT_PUBLIC_ADMIN_PATH_PREFIX=saifulAdv
# NEXT_PUBLIC_ADMIN_PATH_PREFIX="musaAdv"

# PostgreSQL client tools — only needed for restoring legacy backups that contain database.sql
# PG_BIN_DIR="D:/FAZLUL/Others/PostgreSQL/bin"
